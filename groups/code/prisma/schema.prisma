// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  name      String?
  groups    Group[]
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?   @unique
}

model Group {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  name       String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  teacherId  Int
  students   Student[]
  groupstudent GroupStudent[]
}

model Student {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  name         String
  group        Group?   @relation(fields: [groupId], references: [id])
  groupId      Int?
  groupstudent GroupStudent[]
  avatar       Avatar[]
  progress     BattlepassProgress[]
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @unique
}

model GroupStudent {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  group        Group     @relation(fields: [groupId], references: [id])
  groupId      Int
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    Int
}

model Avatar {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    Int       
  avatarItem   AvatarItemHasAvatar[]
}

model AvatarItem {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  slot         Int 
  name         String
  texture      String
  avatarItem   AvatarItemHasAvatar[]
  battlepassReward BattlepassReward[]
}

model AvatarItemHasAvatar {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  avatar       Avatar    @relation(fields: [avatarId], references: [id])
  avatarId     Int
  avataritem   AvatarItem @relation(fields: [avatarItemId], references: [id])
  avatarItemId Int
}

model Battlepass {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  name         String
  startDate    DateTime
  endDate      DateTime
  rewards      BattlepassReward[]
  progress     BattlepassProgress[]
}

model BattlepassReward {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  level        Int
  avatarItemId Int
  avatarItem   AvatarItem    @relation(fields: [avatarItemId], references: [id])
  battlepassId Int
  battlepass   Battlepass @relation(fields: [battlepassId], references: [id])
}

model BattlepassProgress {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  xp           Int
  level        Int
  battlepassId Int
  battlepass   Battlepass @relation(fields: [battlepassId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    Int
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  role      String    @default("student") // "student" or "teacher"
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  teacher   Teacher?
  student   Student?

  @@map("users")
}

model Map {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  imageUrl  String

  states    MapState[]
}

model MapState {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  zoom      Float    @default(1)
  positionX Float    @default(0)
  positionY Float    @default(0)

  mapId Int @unique
  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
}
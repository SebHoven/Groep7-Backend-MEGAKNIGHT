// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  email     String    @unique
  password  String
  name      String?
  groups    Group[]
  tasks     Task[]
}

model Group {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  name       String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  teacherId  Int
  students   Student[]
  groupstudent GroupStudent[]
}

model Student {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  name         String
  loginCode    String   @unique
  group        Group    @relation(fields: [groupId], references: [id])
  groupId      Int
  groupstudent GroupStudent[]
  taskstudent  TaskStudent[]
  avatar       Avatar[]
  progress     BattlepassProgress[]
}

model Task {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  name         String
  description  String?
  date         DateTime?
  icon         String?
  xp           Int?
  x            Float?
  y            Float?
  completed    Boolean  @default(false)
  teacher      Teacher   @relation(fields: [teacherId], references: [id])
  teacherId    Int
  tasksteps    TaskStep[]
  taskstudent  TaskStudent[]
}

model TaskStep {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  text         String
  completed    Boolean   @default(false)
  tasks        Task      @relation(fields: [taskId], references: [id])
  taskId       Int
}

model GroupStudent {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  group        Group     @relation(fields: [groupId], references: [id])
  groupId      Int
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    Int
}

model TaskStudent {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  task         Task      @relation(fields: [taskId], references: [id])
  taskId       Int
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    Int
}

model Avatar {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  student      Student   @relation(fields: [studentId], references: [id])
  hairColor    AvatarItem @relation("Hair", fields: [hairColorId], references: [id])    
  hairColorId  Int 
  bodyItem     AvatarItem @relation("Body", fields: [bodyItemId], references: [id])
  bodyItemId   Int
  legsItem     AvatarItem @relation("Leg", fields: [legsItemId], references: [id])
  legsItemId   Int
  feetItem     AvatarItem @relation("Feet", fields: [feetItemId], references: [id])
  feetItemId   Int
  skinColor    AvatarItem @relation("Skin", fields: [skinColorId], references: [id])
  skinColorId  Int
  studentId    Int       
}

model AvatarItem {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  slot         Int 
  name         String
  texture      String
  hairColor    Avatar[] @relation("Hair")
  bodyItem     Avatar[] @relation("Body")
  legsItem     Avatar[] @relation("Leg")
  feetItem     Avatar[] @relation("Feet")
  skinColor    Avatar[] @relation("Skin")
  battlepassRewards BattlepassReward[]
}

model Battlepass {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  name         String
  startDate    DateTime
  endDate      DateTime
  rewards      BattlepassReward[]
  progress     BattlepassProgress[]
}

model BattlepassReward {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  level        Int
  avatarItemId Int
  avatarItem   AvatarItem    @relation(fields: [avatarItemId], references: [id])
  battlepassId Int
  battlepass   Battlepass @relation(fields: [battlepassId], references: [id])
}

model BattlepassProgress {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  xp           Int
  level        Int
  battlepassId Int
  battlepass   Battlepass @relation(fields: [battlepassId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    Int
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  role      String    @default("student") // "student" or "teacher"
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Map {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  imageUrl  String

  states    MapState[]
}

model MapState {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  zoom      Float    @default(1)
  positionX Float    @default(0)
  positionY Float    @default(0)

  mapId Int @unique
  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
}
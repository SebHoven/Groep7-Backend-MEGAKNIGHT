generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Avatar {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  studentId    Int       @unique
  
  hairColor    String?
  skinColor    String?
  shirtColor   String?
  pantsColor   String?
  shoeColor    String?
}
